# JARVIS-WEB — Front-end / Back-end / n8n integration
# Copy this file to .env at the project root and set values.
#
# .env lives only at project root. Server, Vite, and scripts load from here
# (public/ and scripts/ do not need .env).
#
# Use either VITE_* or non-VITE_ form per variable — both are read everywhere.

# --- Cartesia (STT/TTS) — required for voice ---
VITE_CARTESIA_API_KEY=
CARTESIA_API_KEY=
VITE_CARTESIA_VOICE_ID=95131c95-525c-463b-893d-803bafdf93c4
CARTESIA_VOICE_ID=95131c95-525c-463b-893d-803bafdf93c4

# --- Latency / bidirectional flow (optimal: send on STT final) ---
# VITE_SEND_TRANSCRIPT_ON_FINAL=true   # Default: true. Send to agent as soon as STT sends final (saves ~2.5s vs waiting for silence).
# VITE_SEND_TRANSCRIPT_ON_FINAL=false # Set to false to wait for silence after speech before sending (higher latency).

# --- n8n webhook — required for LLM replies ---
VITE_N8N_WEBHOOK_URL=https://n8n.hempstarai.com/webhook/7600d4d1-e268-4c35-a853-b39ce7014e96
N8N_WEBHOOK_URL=https://n8n.hempstarai.com/webhook/7600d4d1-e268-4c35-a853-b39ce7014e96

# --- Server ---
PORT=3000

# --- Security (OWASP Developer Guide) ---
# ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com  # CORS for API routes
# WS_AUTH_TOKEN=                    # If set, WebSocket /ws requires ?token=<value>
# RATE_LIMIT_WINDOW_MS=60000        # Rate limit window (default 60s)
# RATE_LIMIT_MAX=100                # Max requests per window (static + API)
# RATE_LIMIT_API_MAX=60             # Max API requests per window
# SECURITY_LOG_ENABLED=0            # 1 = log auth failures, rate limits
# SECURITY_LOG_LEVEL=warn           # debug | info | warn | error
# N8N_PROXY_ENABLED=1               # 1 = enable POST /api/n8n-proxy (browser ↔ n8n; set 1 for full UI integration)
# ALLOWED_N8N_WEBHOOKS=             # Comma-separated URLs for proxy allowlist (default: N8N_WEBHOOK_URL)
# N8N_PROXY_TIMEOUT_MS=120000       # n8n webhook timeout in ms (default 90s). Used by server proxy and Electron; set 120000+ if workflows often time out.

# --- MCP (Desktop Commander in-app) — optional ---
# Set ENABLE_MCP=1 to expose POST /api/mcp/call and GET /api/mcp/tools so n8n or the app can run terminal/file tools.
# ENABLE_MCP=0
# MCP_API_SECRET=    # If set, require X-MCP-Secret or Authorization: Bearer <secret> on requests.
# MCP_USE_DOCKER=1   # 1 = run Desktop Commander via Docker; 0 = use npx.
# MCP_DOCKER_IMAGE=mcp/desktop-commander:latest
# MCP_WORKSPACE_PATH= # Default: process.cwd() (project root). Mounted as /workspace in Docker.

# --- electron-builder code signing (optional, for production installers) ---
# See https://www.electron.build/code-signing
# macOS: CSC_LINK = path or HTTPS link to .p12; CSC_KEY_PASSWORD = cert password.
# Windows (or when building Windows on Mac): WIN_CSC_LINK, WIN_CSC_KEY_PASSWORD.
# CSC_NAME=     # macOS: certificate name if multiple identities (optional).
# CSC_IDENTITY_AUTO_DISCOVERY=true   # macOS: use keychain identity (default true).
# CSC_KEYCHAIN= # Keychain name if not using default.
