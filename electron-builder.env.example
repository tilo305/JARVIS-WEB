# electron-builder environment (optional)
# Copy to electron-builder.env in project root. Used only when running electron-builder CLI.
# See https://www.electron.build/code-signing
#
# CSC_LINK=            # Certificate: file path, HTTPS link, or base64-encoded .p12/.pfx
# CSC_KEY_PASSWORD=    # Password to decrypt the certificate
# CSC_NAME=            # macOS: certificate name (if multiple identities)
# WIN_CSC_LINK=        # Windows cert when building Windows on non-Windows host
# WIN_CSC_KEY_PASSWORD=
