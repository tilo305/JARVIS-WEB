{
  "name": "jarvis-web-cartesia",
  "version": "1.0.0",
  "description": "Bidirectional conversational AI using Cartesia STT and TTS WebSockets",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "example": "node dist/examples/bidirectional-conversation.js",
    "serve": "node server.js",
    "serve:prod": "node scripts/kill-port-then-vite.mjs build && node server.js",
    "dev:browser": "vite",
    "vite": "concurrently --kill-others-on-fail=false \"node scripts/kill-port-then-vite.mjs\" \"npm run openwakeword\"",
    "vite:build": "node scripts/kill-port-then-vite.mjs build",
    "preview": "vite preview",
    "dev:full": "node scripts/kill-port-then-vite.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "lint:src": "eslint src/",
    "lint:public": "eslint public/",
    "lint:server": "eslint server.js vite.config.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit --collectCoverage=false",
    "test:all": "jest --coverage --verbose --watchAll=false",
    "test:ci": "jest --coverage --ci --watchAll=false",
    "ci": "npm run build && npm run lint:check && npm run test:coverage",
    "verify": "npm run lint:check && npm run build && npm test",
    "check": "npm run lint:check && npm run build && npm test -- --watchAll=false && npm run vite:build",
    "debug": "node debug/run-debug-suite.mjs",
    "debug:live": "jest debug/live",
    "openwakeword": "node scripts/start-openwakeword-server.mjs",
    "test:wakeword": "node debug/tools/verify-wake-word-setup.js",
    "test:wakeword:activation": "node debug/tools/test-wake-word-activation-flow.js",
    "test:wakeword:cli": "node debug/tools/wake-word-activation-test-cli.js",
    "debug:openwakeword": "node debug/tools/debug-openwakeword-config-live.js",
    "debug:openwakeword:websocket": "node debug/tools/debug-openwakeword-websocket-live.js",
    "test:debug": "jest --coverage > debug/results/latest-test-run.txt 2>&1",
    "test:integration": "jest debug/tests/integration"
  },
  "keywords": [
    "cartesia",
    "stt",
    "tts",
    "websocket",
    "voice",
    "conversation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "dotenv": "^17.2.3",
    "jspdf": "^4.1.0",
    "tesseract.js": "^5.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^9.39.2",
    "@jest/globals": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "kill-port": "^2.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.54.0",
    "concurrently": "^9.1.2",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0"
  }
}
