{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: build",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "npm: dev (Vite)",
      "type": "shell",
      "command": "npm run dev:browser",
      "group": "build",
      "isBackground": true,
      "presentation": { "reveal": "always" }
    },
    {
      "label": "npm: test",
      "type": "shell",
      "command": "npm test",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always" }
    },
    {
      "label": "npm: lint",
      "type": "shell",
      "command": "npm run lint:check",
      "group": "none",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "npm: verify",
      "type": "shell",
      "command": "npm run verify",
      "group": "test",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "npm: serve",
      "type": "shell",
      "command": "npm run serve",
      "group": "build",
      "isBackground": true,
      "presentation": { "reveal": "always" }
    }
  ]
}
